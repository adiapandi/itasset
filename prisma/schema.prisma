// iAsset — schema through Phase 4
// Phase 1: Identity & Access (users/roles/permissions) + audit trail.
// Phase 2: Asset Catalog (vendors/categories/models/assets).
// Phase 3: Locations (buildings/rooms/room PICs) + Asset.currentRoomId/currentPicId.
// Phase 4: Employee assignment (Asset.assignedUserId) + AssetAssignment history log.
// Transfer + approval workflow (room movement history) lands in Phase 5.
// (the full target schema is sketched in the architecture doc / ERD).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== IDENTITY & ACCESS =====================

model Department {
  id              String       @id @default(cuid())
  name            String
  code            String       @unique
  parentDeptId    String?
  manager         User?        @relation("DepartmentManager", fields: [managerId], references: [id])
  managerId       String?
  users           User[]       @relation("UserDepartment")
  assets          Asset[]
  rooms           Room[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("departments")
}

model User {
  id            String       @id @default(cuid())
  employeeId    String?      @unique
  name          String
  email         String       @unique
  passwordHash  String
  phone         String?
  avatarUrl     String?
  isActive      Boolean      @default(true)

  department    Department?  @relation("UserDepartment", fields: [departmentId], references: [id])
  departmentId  String?

  managedDepts  Department[] @relation("DepartmentManager")

  roles         UserRole[]
  auditLogs     AuditLog[]
  roomPics      RoomPic[]
  assetsInCharge Asset[]     @relation("AssetCurrentPic")
  assetsAssigned Asset[]     @relation("AssetAssignedUser")
  assetAssignments AssetAssignment[] @relation("AssetAssignmentUser")

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@map("users")
}

model Role {
  id          String            @id @default(cuid())
  name        String            @unique   // e.g. "Super Admin", "Room PIC"
  description String?
  isSystem    Boolean           @default(false) // system roles (from seed) can't be deleted via UI

  users       UserRole[]
  permissions RolePermission[]

  createdAt   DateTime          @default(now())

  @@map("roles")
}

model Permission {
  id          String            @id @default(cuid())
  code        String            @unique  // e.g. "asset.create", "transfer.approve"
  module      String            // e.g. "asset", "transfer", "admin"
  description String?

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId   String

  @@id([userId, roleId])
  @@map("user_roles")
}

// ===================== AUDIT TRAIL (foundational, used from Phase 1 on) =====================

model AuditLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  action     String   // e.g. "user.create", "user.update"
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ===================== ASSET CATALOG (Phase 2) =====================
// Rooms/transfers/assignment (current_room_id, assigned_user_id, etc.)
// are NOT wired up yet — those land in Phase 3/4/5. Phase 2 only owns
// the asset record itself and its catalog reference data.

model Vendor {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?

  assets        Asset[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@map("vendors")
}

model AssetCategory {
  id               String          @id @default(cuid())
  name             String
  code             String          @unique
  parentCategoryId String?
  parentCategory   AssetCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children         AssetCategory[] @relation("CategoryHierarchy")

  models           AssetModel[]
  assets           Asset[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  @@map("asset_categories")
}

model AssetModel {
  id           String        @id @default(cuid())
  name         String
  brand        String?
  manufacturer String?
  specs        Json?

  category     AssetCategory @relation(fields: [categoryId], references: [id])
  categoryId   String

  assets       Asset[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@map("asset_models")
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_STORAGE
  UNDER_MAINTENANCE
  DAMAGED
  LOST
  STOLEN
  RETIRED
  DISPOSED
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

model Asset {
  id                String          @id @default(cuid())
  assetCode         String          @unique // e.g. AST-IT-000123
  name              String
  serialNumber      String?         @unique

  category          AssetCategory   @relation(fields: [categoryId], references: [id])
  categoryId        String
  model             AssetModel?     @relation(fields: [modelId], references: [id])
  modelId           String?
  brand             String?

  vendor            Vendor?         @relation(fields: [vendorId], references: [id])
  vendorId          String?

  department        Department?     @relation(fields: [departmentId], references: [id])
  departmentId      String?

  purchaseDate      DateTime?
  purchasePrice     Decimal?        @db.Decimal(14, 2)
  warrantyStartDate DateTime?
  warrantyEndDate   DateTime?

  status            AssetStatus     @default(AVAILABLE)
  condition         AssetCondition  @default(GOOD)

  qrCodeValue       String?         @unique
  barcodeValue      String?
  photoUrl          String?
  notes             String?

  currentRoom       Room?           @relation(fields: [currentRoomId], references: [id])
  currentRoomId     String?
  // Denormalized "who's accountable right now" — kept in sync with the room's
  // primary RoomPic by the room/asset services whenever a PIC or room changes.
  // Phase 4/5 will layer employee assignment (assignedUserId) on top of this.
  currentPic        User?           @relation("AssetCurrentPic", fields: [currentPicId], references: [id])
  currentPicId      String?

  // Phase 4: employee assignment — deliberately separate from currentRoomId/
  // currentPicId. A laptop can be assignedUserId=Jane while currentRoomId
  // points at the IT Office; a server can have currentRoomId set with
  // assignedUserId left null. See AssetAssignment for the history log.
  assignedUser      User?           @relation("AssetAssignedUser", fields: [assignedUserId], references: [id])
  assignedUserId    String?

  assignments       AssetAssignment[]

  createdBy         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([status])
  @@index([categoryId])
  @@index([currentRoomId])
  @@index([assignedUserId])
  @@map("assets")
}

enum AssignmentType {
  EMPLOYEE
  ROOM
  DEPARTMENT
  STORAGE
}

// Immutable log of "who/where was accountable for this asset, and when" —
// never updated in place, only closed (endedAt set) and superseded by a new
// row. Phase 4 only writes EMPLOYEE rows; ROOM movement gets its own
// approval-backed log (asset_transfers) in Phase 5 rather than reusing this
// table, per the architecture doc's split between assignment and transfer.
model AssetAssignment {
  id             String         @id @default(cuid())
  asset          Asset          @relation(fields: [assetId], references: [id])
  assetId        String

  assignmentType AssignmentType
  user           User?          @relation("AssetAssignmentUser", fields: [userId], references: [id])
  userId         String?

  startedAt      DateTime       @default(now())
  endedAt        DateTime?
  reason         String?
  createdBy      String?

  @@index([assetId, endedAt])
  @@map("asset_assignments")
}

// ===================== LOCATIONS (Phase 3) =====================

model Building {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?

  rooms     Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("buildings")
}

enum RoomType {
  OFFICE
  MEETING_ROOM
  SERVER_ROOM
  WAREHOUSE
  STORAGE_ROOM
  RECEPTION
  TRAINING_ROOM
  OTHER
}

enum RoomStatus {
  ACTIVE
  INACTIVE
}

model Room {
  id           String     @id @default(cuid())
  roomCode     String     @unique
  name         String

  building     Building   @relation(fields: [buildingId], references: [id])
  buildingId   String
  floor        String?

  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  roomType     RoomType   @default(OFFICE)
  capacity     Int?
  description  String?
  status       RoomStatus @default(ACTIVE)

  pics         RoomPic[]
  assets       Asset[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@index([buildingId])
  @@map("rooms")
}

enum PicType {
  PRIMARY
  BACKUP
}

model RoomPic {
  id           String    @id @default(cuid())

  room         Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId       String
  user         User      @relation(fields: [userId], references: [id])
  userId       String

  picType      PicType
  isActive     Boolean   @default(true)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  // A room can have at most one ACTIVE primary PIC at a time (backups are
  // unlimited) — enforced in the service layer since Prisma can't express
  // a partial unique index directly; see room.service.ts assignPic().

  @@index([roomId, isActive])
  @@map("room_pics")
}
